node_modules/

# Vite's build output (deployed by GitHub Actions, never committed)
dist/

# Worker secrets for `wrangler dev` (the Gemini key). Never commit these.
worker/.dev.vars
worker/.dev.vars.*
worker/.env
worker/.env.*

# Wrangler's local build and state folder (any level)
.wrangler/

# Left behind only if vite.test.js is killed mid-run
deny-test-*/
