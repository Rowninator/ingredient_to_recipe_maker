node_modules/

# Vite's build output (deployed by GitHub Actions, never committed)
dist/
# The Android app's build (`npm run build:android`), copied into android/ by cap sync
dist-android/

# Android signing keys and their passwords. Never commit these.
*.jks
*.keystore
keystore.properties

# Worker secrets for `wrangler dev` (the Gemini key). Never commit these.
worker/.dev.vars
worker/.dev.vars.*
worker/.env
worker/.env.*

# Wrangler's local build and state folder (any level)
.wrangler/

# Left behind only if vite.test.js is killed mid-run
deny-test-*/
